# ReclaimIQ frontend — generated by scripts/gen_secrets.py from the repo root.
# AUTH_SECRET is random; KEYCLOAK_CLIENT_SECRET matches the generated web client.

AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
KEYCLOAK_ISSUER=http://localhost:8081/realms/returnguard
KEYCLOAK_CLIENT_ID=returnguard-web
KEYCLOAK_CLIENT_SECRET=
BACKEND_URL=http://localhost:8000
